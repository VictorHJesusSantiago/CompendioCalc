@page "/buscar"
@inject AdvancedSearchService Search
@inject FormulaService Fs
@inject PersonalDataService PersonalData
@inject NavigationManager Nav

<div style="padding:12px 16px 8px">
    <div class="section-title" style="font-family:var(--font-display);font-size:22px;margin-bottom:12px">Buscar</div>
    <div style="position:relative">
        <span class="search-icon" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--text-muted)">⊕</span>
        <input class="search-input"
               type="search"
               placeholder="Buscar por nome, criador, categoria…"
               @bind="_query"
               @bind:event="oninput"
               @bind:after="FilterResults" />
    </div>
    <div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap">
        <select class="calc-input" @bind="_category" @bind:after="FilterResults" aria-label="Filtrar por categoria">
            <option value="">Todas as categorias</option>
            @foreach (var category in Fs.ObterCategorias()) { <option value="@category.Nome">@category.Nome</option> }
        </select>
        <select class="calc-input" @bind="_difficulty" @bind:after="FilterResults" aria-label="Filtrar por dificuldade">
            <option value="">Todas as dificuldades</option>
            @foreach (var difficulty in Enum.GetValues<NivelDificuldade>()) { <option value="@difficulty">@difficulty</option> }
        </select>
        @if (!string.IsNullOrWhiteSpace(_query))
        {
            <button class="calc-btn" @onclick="SaveSearch">Salvar busca</button>
        }
    </div>
</div>

@if (string.IsNullOrWhiteSpace(_query))
{
    <div class="empty-state">
        <div class="empty-icon">⊕</div>
        <div class="empty-title">Busque qualquer equação</div>
        <div class="empty-sub">Digite o nome da fórmula, criador, categoria ou qualquer termo relacionado.</div>
    </div>
}
else if (!_results.Any())
{
    <div class="empty-state">
        <div class="empty-icon">∅</div>
        <div class="empty-title">Nenhum resultado</div>
        <div class="empty-sub">Tente termos mais simples como "Newton", "integral" ou "probabilidade".</div>
    </div>
}
else
{
    <div style="padding: 4px 16px 8px">
        <span style="font-size:12px;color:var(--text-muted)">@_results.Count resultado(s) para "<span style="color:var(--gold)">@_query</span>"</span>
    </div>
    <div class="formula-list">
        @foreach (var hit in _results)
        {
            var f = hit.Formula;
            <div class="formula-card" @onclick='() => Nav.NavigateTo($"/formula/{f.Id}")'>
                <div class="formula-card-top">
                    <div class="formula-icon">@f.Icone</div>
                    <div class="formula-meta">
                        <div class="formula-name">@f.Nome</div>
                        <div class="formula-author">@f.Criador</div>
                    </div>
                </div>
                <div class="formula-expr">@f.ExprTexto</div>
                <div class="formula-tag">@f.Categoria</div>
                <div class="input-desc">Relevância @hit.Score.ToString("0.00") · @string.Join(", ", hit.MatchedFields)</div>
            </div>
        }
    </div>
}

@code {
    string _query = "";
    string _category = "";
    string _difficulty = "";
    List<SearchHit> _results = [];

    void FilterResults()
    {
        NivelDificuldade? difficulty = Enum.TryParse<NivelDificuldade>(_difficulty, out var parsed) ? parsed : null;
        _results = string.IsNullOrWhiteSpace(_query) ? [] :
            Search.Search(_query, new SearchOptions(
                Category: string.IsNullOrWhiteSpace(_category) ? null : _category,
                Difficulty: difficulty, Limit: 50)).ToList();
    }

    void SaveSearch() => PersonalData.SaveSearch(new SavedSearch
    {
        Name = _query,
        Query = _query,
        Filters = new() { ["categoria"] = _category, ["dificuldade"] = _difficulty }
    });
}
